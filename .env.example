# VINCÓ backend — environment variables. Copy to .env for local dev.
# NEVER commit real secrets.

# Postgres connection string (required). Railway/Render provide this automatically.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vinco

# Port the HTTP server listens on (platforms inject PORT automatically).
PORT=8080

# Public base URL of this backend, used for Stripe success/cancel URLs and sitemap.
PUBLIC_BASE_URL=http://localhost:8080

# Stripe secret key (optional). WITHOUT it, createcheckout returns the honest
# business error STRIPE_NOT_CONFIGURED. No test keys are shipped.
STRIPE_SECRET_KEY=

# Node environment: development | production
NODE_ENV=development
